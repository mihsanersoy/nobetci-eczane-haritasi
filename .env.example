# ==========================================
# UYGULAMA GENEL AYARLARI
# ==========================================
PROJECT_NAME="Nöbetçi Eczane API"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# ==========================================
# POSTGRESQL VERİTABANI AYARLARI
# ==========================================
POSTGRES_USER=eczane_user
POSTGRES_PASSWORD=eczane_secret_pass
POSTGRES_DB=nobetci_eczane_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://eczane_user:eczane_secret_pass@db:5432/nobetci_eczane_db

# ==========================================
# REDIS CACHE AYARLARI
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# ==========================================
# CORS & FRONTEND AYARLARI
# ==========================================
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
